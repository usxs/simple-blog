# 镜像名与标签：用 Docker Hub 镜像部署时生效（docker-compose.hub.yml），从源码构建时可不管
IMAGE_NAME=starspacec/simple-blog-backend
IMAGE_TAG=latest

# ===== 后端环境变量（复制为 .env 后修改；docker compose 会自动读取）=====

# 后台监听端口（宿主机侧）。容器内固定 33001，默认只绑定 127.0.0.1，由 Nginx 反代对外
HOST_PORT=33001

# ---- 存储模式（V2 新增）----
# sqlite（默认）：文章/评论/站点配置存在 data/blog.db，图片附件仍在 img/ file/
# file：回退到 V1 的 Markdown 文件存储，迁移前后想对比内容时用
STORE=sqlite
# 数据库文件位置（容器内路径；宿主机上对应 ./data/blog.db）
DB_FILE=/app/data/blog.db

# ---- 管理员账号（仅用于首次初始化 data/auth.json，之后请在后台改密码）----
ADMIN_USERNAME=admin
# 至少 8 位；留空则首次访问后台会出现「初始化管理员」向导页
ADMIN_PASSWORD=

# ---- 站点地址（影响 sitemap 与 IndexNow 推送里的绝对 URL，必须填真实域名）----
SITE_PUBLIC_URL=https://www.example.com
BACKEND_PUBLIC_URL=https://api.example.com

# ---- 验证码签名密钥：留空会自动生成并保存到 data/captcha-secret.json ----
# 生成方式：openssl rand -hex 32
CAPTCHA_SECRET=

# ---- IndexNow（可选，Bing / Yandex / Seznam / Naver 的即时收录推送）----
# 生成方式：openssl rand -hex 16
# 也可以留空，改在后台「管理 → 搜索引擎推送」里填写（后台值优先于这里）
# 填好后还需在前端站点根目录放一个同名文本文件 <INDEXNOW_KEY>.txt，内容就是这个 key
INDEXNOW_KEY=
# key 文件的完整 URL，留空则默认为 ${SITE_PUBLIC_URL}/<INDEXNOW_KEY>.txt
INDEXNOW_KEY_LOCATION=

# ---- 站点信息初始值（后台「管理」页可随时修改，改完立即生效，无需重启）----
SITE_NAME=简单博客
# 头像文字，1-2 个字
SITE_AVATAR=简
# 浏览器标签页标题
SITE_TITLE=简单博客
SITE_SUBTITLE=这里是我的个人博客，记录技术、折腾与生活。

# 首页社交链接（也可以登录后台在「管理 → 社交链接」里改）
SITE_GITHUB=
SITE_X=
SITE_TELEGRAM=
# 邮箱可写 mailto:hi@example.com 或直接 hi@example.com
SITE_EMAIL=

# 页脚备案号（也可以登录后台在「管理 → 页脚与备案」里改；留空则不显示）
# ICP：京ICP备2026000001号-1  公安：京公网安备 11010502030146号  萌 ICP：萌ICP备20231234号
# 前台只显示图标，悬停看号码、点击跳官方查询页
SITE_ICP=
SITE_POLICE=
SITE_MOE=
# 是否显示「© 年份 站名 · All Rights Reserved.」（1 = 显示，0 = 隐藏；后台可随时改）
SITE_COPYRIGHT=1

# ---- 两步验证 / 通行密钥 ----
# 通行密钥（Passkey）要求 HTTPS；若反向代理域名与后端 host 不同，可显式指定：
# WEBAUTHN_RP_ID=api.example.com
# WEBAUTHN_ORIGIN=https://api.example.com
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# ---- 探针数据来源（可选；也可在后台「管理 → 探针」里改，改完立即生效）----
# 1 = 启用前台探针页的数据，0 = 关闭
PROBE_ENABLED=1
# cf = CF-Server-Monitor（读 <PROBE_URL>/api/servers）
# minimal = 极简探针 monitor（读 <PROBE_URL>/api/nodes，未登录时只显示公开节点）
PROBE_PROVIDER=cf
# 探针面板首页地址，例如 https://monitor.example.com
PROBE_URL=
# 「打开监控后台」按钮的目标地址（可留空，留空则前台不显示该按钮）
PROBE_PANEL_URL=

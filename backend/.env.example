# ===== 后端环境变量（复制为 .env 后修改；docker compose 会自动读取）=====

# 后台监听端口（宿主机侧）。容器内固定 33001，默认只绑定 127.0.0.1，由 Nginx 反代对外
HOST_PORT=33001

# ---- 管理员账号（仅用于首次初始化 data/auth.json，之后请在后台改密码）----
ADMIN_USERNAME=admin
# 至少 8 位；留空则首次访问后台会出现「初始化管理员」向导页
ADMIN_PASSWORD=

# ---- 站点地址（影响 sitemap 与 IndexNow 推送里的绝对 URL，必须填真实域名）----
SITE_PUBLIC_URL=https://www.example.com
BACKEND_PUBLIC_URL=https://api.example.com

# ---- 验证码签名密钥：留空会自动生成并保存到 data/captcha-secret.json ----
# 生成方式：openssl rand -hex 32
CAPTCHA_SECRET=

# ---- IndexNow（可选，Bing / Yandex / Seznam / Naver 的即时收录推送）----
# 生成方式：openssl rand -hex 16
# 填好后还需在前端站点根目录放一个同名文本文件 <INDEXNOW_KEY>.txt，内容就是这个 key
INDEXNOW_KEY=
# key 文件的完整 URL，留空则默认为 ${SITE_PUBLIC_URL}/<INDEXNOW_KEY>.txt
INDEXNOW_KEY_LOCATION=

# ---- 服务器探针数据源（可选）----
# 兼容 CF-Server-Monitor 的 /api/servers 接口，例如 https://monitor.example.com/api/servers
PROBE_SERVERS_URL=
